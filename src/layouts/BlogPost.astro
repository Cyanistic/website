---
import type { CollectionEntry } from 'astro:content';
import Bar from '../components/Bar.astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label={`Article: ${title}`} showFooter={false}>
			<main class="article-main">
				<article>
					{heroImage && (
						<img class="hero-image" width="1020" height="510" src={heroImage} alt="" />
					)}
					<header class="article-header">
						<p class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
						</p>
						<h1>{title}</h1>
						<p class="dek">{description}</p>
					</header>
					<div class="prose"><slot /></div>
				</article>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.article-main {
		width: min(100%, 80ch);
		padding-block: clamp(1.3rem, 3vw, 2.7rem) 3rem;
	}

	article {
		width: 100%;
	}

	.hero-image {
		display: block;
		width: 100%;
		margin-bottom: 1.8rem;
		border-radius: 7px;
	}

	.article-header {
		margin-bottom: 2rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--rule);
	}

	.date {
		display: flex;
		gap: 1rem;
		margin: 0 0 0.65rem;
		color: var(--green);
		font-size: 0.78rem;
	}

	h1 {
		margin-bottom: 0.75rem;
		font-size: clamp(1.55rem, 3.4vw, 2.35rem);
		line-height: 1.18;
	}

	.dek {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.prose {
		color: var(--text);
		font-size: 1rem;
		line-height: 1.75;
	}

	.prose :global(h2) {
		margin-top: 2.6rem;
		margin-bottom: 0.8rem;
		font-size: 1.45rem;
	}

	.prose :global(h3) {
		margin-top: 2rem;
		margin-bottom: 0.65rem;
		font-size: 1.16rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-top: 0;
		margin-bottom: 1.25rem;
	}

	.prose :global(a) {
		text-decoration: underline;
	}

	.prose :global(img) {
		border-radius: 4px;
	}

	@media (max-width: 620px) {
		.article-main {
			padding: 1rem 0.95rem 2rem;
		}

		.date {
			flex-direction: column;
			gap: 0.15rem;
		}

		.prose {
			font-size: 0.94rem;
			line-height: 1.68;
		}
	}
</style>
