---
import Footer from './Footer.astro';

interface Props {
	label?: string;
	showFooter?: boolean;
}

const { label = 'Page content', showFooter = true } = Astro.props;
---

<div class="workspace-pane" tabindex="0" aria-label={label}>
	<div class="workspace-pane-scroll">
		<slot />
		{showFooter && <Footer />}
	</div>
</div>
