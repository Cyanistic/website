---
import Footer from './Footer.astro';
import { workspaceTransition } from '../transitions';

interface Props {
	label?: string;
	showFooter?: boolean;
}

const { label = 'Page content', showFooter = true } = Astro.props;
---

<div
	class="workspace-content workspace-pane"
	transition:name="workspace-content"
	transition:animate={workspaceTransition}
	tabindex="0"
	aria-label={label}
>
	<div class="workspace-pane-scroll">
		<slot />
		{showFooter && <Footer />}
	</div>
</div>
