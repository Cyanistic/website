---
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<section class="content-section">
	<header>
		<h1>{title}</h1>
		{description && <p>{description}</p>}
	</header>
	<slot />
</section>

<style>
	.content-section {
		padding: 0;
	}

	header {
		margin-bottom: 1.25rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--rule);
	}

	h1 {
		margin: 0 0 0.45rem;
		font-size: clamp(1.55rem, 3vw, 2.2rem);
	}

	p {
		max-width: 70ch;
		margin: 0;
		color: var(--text-muted);
		font-size: 0.94rem;
	}
</style>
