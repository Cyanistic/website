---
interface Props {
	title: string;
	description: string;
	icon?: string;
	url?: string;
	date?: string;
	showHint?: boolean;
}

const { title, description, icon, url, date } = Astro.props;
---

<div class="card-wrapper">
	<article class="catalog-item">
		<header>
			{icon && <img src={icon} alt="" width="34" height="34" />}
			<div>
				{url ? <h2><a href={url}>{title}</a></h2> : <h2>{title}</h2>}
				{date && <time>{date}</time>}
			</div>
		</header>
		<p class="description">{description}</p>
		<div class="item-content"><slot /></div>
	</article>
</div>

<style>
	.card-wrapper {
		min-width: 0;
	}

	.catalog-item {
		height: 100%;
		padding: 1rem 0;
		border-top: 1px solid var(--rule);
	}

	header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.65rem;
	}

	img {
		width: 34px;
		height: 34px;
		flex: 0 0 34px;
		object-fit: contain;
	}

	h2 {
		margin: 0;
		font-size: 1.05rem;
	}

	h2 a {
		color: var(--text-bright);
		text-decoration: none;
	}

	h2 a:hover,
	h2 a:focus-visible {
		color: var(--focus-companion);
	}

	time {
		display: block;
		margin-top: 0.2rem;
		color: var(--green);
		font-size: 0.74rem;
	}

	.description,
	.item-content {
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.description {
		margin-bottom: 0.7rem;
	}

	.item-content :global(p) {
		margin: 0;
	}

	.item-content :global(a) {
		color: var(--default);
	}
</style>
