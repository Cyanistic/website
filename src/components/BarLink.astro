---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

// src is the path to an image
const { href, title, class: className, ...props } = Astro.props;

const { pathname} = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, '');
---

<a href={href} title={title} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		transition: scale 1s cubic-bezier(0.16, 0.35, 0, 1.15);
		scale: 1;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference){
		a:hover{
			--bg-size: 200%;
			color: transparent;
			background: linear-gradient(130deg, var(--default), var(--selected), var(--default)) 0 0 / var(--bg-size) 100%;
			background-clip: text;
			scale: 1.1;
			animation: gradientAnimation 1s linear infinite;
		}
		@keyframes gradientAnimation{
			to {
				background-position: var(--bg-size) 0;
			}
		}
	}
</style>
