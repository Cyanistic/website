---
import BarLink from './BarLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-bar">
	<nav aria-label="Primary">
		<div class="bar-cluster workspaces">
			<div class="cluster-body">
				<BarLink href="/" title="Home">󰋜</BarLink>
				<BarLink href="/projects" title="Projects">󰐯</BarLink>
				<BarLink href="/software" title="Software"></BarLink>
				<BarLink href="/blog" title="Writing">󰂺</BarLink>
				<BarLink href="/about" title="About">󰀄</BarLink>
			</div>
			<span class="tri" aria-hidden="true"></span>
		</div>

		<p class="site-title"><a href="/">{SITE_TITLE}</a></p>

		<div class="bar-cluster site-links">
			<span class="tri" aria-hidden="true"></span>
			<div class="cluster-body">
				<BarLink href="/donate" title="Donate">󰋑</BarLink>
				<BarLink href="https://github.com/Cyanistic" title="GitHub"></BarLink>
				<BarLink href="/rss.xml" title="RSS"></BarLink>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-bar {
		position: relative;
		z-index: 10;
		width: 100%;
		height: 100%;
		min-width: 0;
		border: 3px solid var(--default);
		border-radius: 20px;
		background: var(--bar-bg);
		color: var(--default);
	}

	nav {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		width: 100%;
		height: 100%;
		align-items: center;
	}

	.bar-cluster {
		display: flex;
		height: 44px;
		align-items: stretch;
	}

	.cluster-body {
		display: flex;
		align-items: center;
		padding: 0 6px;
		background: var(--module-bg);
	}

	.workspaces {
		grid-column: 1;
		justify-self: start;
	}

	.workspaces .cluster-body {
		border-radius: 17px 0 0 17px;
	}

	.site-links {
		grid-column: 3;
		justify-self: end;
	}

	.site-links .cluster-body {
		border-radius: 0 17px 17px 0;
	}

	.tri {
		display: block;
		height: 44px;
		overflow: hidden;
		margin: 0;
		color: var(--module-bg);
		font-size: 34px;
		font-weight: 400;
		line-height: 48px;
		user-select: none;
	}

	.site-title {
		position: absolute;
		left: 50%;
		margin: 0;
		transform: translateX(-50%);
		font-size: 0.95rem;
		font-weight: 400;
		letter-spacing: 0.035em;
		white-space: nowrap;
	}

	.site-title a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.site-title a:hover,
	.site-title a:focus-visible {
		color: var(--focus-companion);
	}

	@media (max-width: 670px), (hover: none) and (pointer: coarse) {
		nav {
			display: block;
		}

		.site-title,
		.site-links {
			display: none;
		}

		.workspaces {
			width: 100%;
			height: 70px;
		}

		.workspaces .cluster-body {
			width: 100%;
			justify-content: space-around;
			padding: 0 4px;
			border-radius: 17px;
		}

		.tri {
			display: none;
		}
	}
</style>
