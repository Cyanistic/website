---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Bar from '../../components/Bar.astro';
import TerminalCard from '../../components/TerminalCard.astro';
import TerminalLayout from '../../components/TerminalLayout.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label="Writing">
			<main>
				<TerminalLayout title="Writing" description="Notes on Rust, software, and things I care about.">
					<div class="writing-list">
						{posts.map((post) => (
							<TerminalCard
								title={post.data.title}
								description={post.data.description}
								date={post.data.pubDate.toLocaleDateString()}
								url={`/blog/${post.id}/`}
								showHint={false}
							/>
						))}
					</div>
				</TerminalLayout>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.writing-list {
		max-width: 78ch;
	}
</style>
