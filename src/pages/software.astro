---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Bar from '../components/Bar.astro';
import TerminalCard from '../components/TerminalCard.astro';
import TerminalLayout from '../components/TerminalLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const software = await getCollection('software');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Software | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label="Software">
			<main>
				<TerminalLayout title="Software" description="The software I use and why it has a place in my setup.">
					<div class="catalog-grid">
						{software.map(async (item) => {
							const { Content } = await render(item);
							return (
								<TerminalCard
									title={item.data.title}
									description={item.data.description ?? ''}
									icon={item.data.icon}
									url={item.data.url}
								>
									<Content />
								</TerminalCard>
							);
						})}
					</div>
				</TerminalLayout>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
	}

	@media (max-width: 720px) {
		.catalog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
