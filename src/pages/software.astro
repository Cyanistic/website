---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, customSlide } from '../consts';

const software = await getCollection('software');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
		div.program{
			opacity: 0;
			filter: blur(5px);
			transition: all 1s;
		}

		div:nth-child(odd){
			transform: translateX(-100%);
		}

		div:nth-child(even){
			transform: translateX(100%);
		}

		div.show{
			opacity: 1;
			filter: blur(0);
			transform: translateX(0);
		}

		@media (prefers-reduced-motion: no-preference) {
		  div.program {
		    transition: all 1s;
		  }
		}

		</style>

		<script defer='true'>
		function showPrograms(){
			const observer = new IntersectionObserver(entries => {
			entries.forEach(e => {
					console.log(e)
					if (e.isIntersecting){
						e.target.classList.add('show');
					}
				})
			})

			const hiddenprograms = document.querySelectorAll('.program');
			hiddenprograms.forEach(e => observer.observe(e))
		}
		showPrograms()
		document.addEventListener('astro:page-load', showPrograms)
		</script>
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main transition:animate>
			<h1>Software I Use</h1>
			<p>
				This is a list of software that I use on a daily basis. These programs are configured to be as effcient as possible to suit my needs and workflow.
				My personal configurations for all of these programs can be found <a href="https://codeberg.org/Cyanism/Dotfiles">here</a>. 
			</p>
			{
				software.map((program: any) => (
					<div class="program">
						<a href={program.data.url}>
							<h2>{program.data.title}</h2>
							{
								program.data.icon && 
								(<img height={200} width={200} src={program.data.icon} alt={`${program.data.title}-image`}/>)
							} 
						</a>
						<h4>{program.data.description}</h2>
						<p>{program.body}</p>
					</div>
				))
			}
		</main>
		<Footer />
	</body>
</html>

