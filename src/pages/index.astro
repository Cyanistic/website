---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Bar from '../components/Bar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { workspaceTransition } from '../transitions';

const projects = await getCollection('projects');
const lokr = projects.find((project) => project.id === 'lokr');
if (!lokr) throw new Error('The lokr project entry is required for the homepage.');
const { Content: LokrContent } = await render(lokr);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);

const software = await getCollection('software');
const desktopTools = ['hyprland', 'eww', 'foot']
	.map((id) => software.find((item) => item.id === id))
	.filter((item): item is NonNullable<typeof item> => Boolean(item));

const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
}).format(date);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />

		<div class="workspace-content" transition:name="workspace-content" transition:animate={workspaceTransition}>
		<main class="home-workspace" aria-label="Home workspace">
			<section class="workspace-pane lead-pane" tabindex="0" aria-labelledby="home-title">
				<div class="workspace-pane-scroll">
				<header class="home-intro">
					<h1 id="home-title">{SITE_TITLE}</h1>
					<p>{SITE_DESCRIPTION}</p>
				</header>

				<article class="lead-project">
					<div class="project-heading">
						{lokr.data.icon && <img src={lokr.data.icon} alt="" width="58" height="58" />}
						<h2>{lokr.data.title}</h2>
					</div>
					<p class="project-description">{lokr.data.description}</p>
					<div class="project-copy"><LokrContent /></div>
					<nav class="project-actions" aria-label="Lokr links">
						<a class="primary-link" href="https://lokr.cyanistic.com">Open Lokr <span aria-hidden="true">↗</span></a>
						{lokr.data.url && <a href={lokr.data.url}>Repository</a>}
						<a href="/projects">All projects</a>
					</nav>
				</article>
				</div>
			</section>

			<section class="workspace-pane writing-pane" tabindex="0" aria-labelledby="writing-title">
				<div class="workspace-pane-scroll">
				<header class="pane-heading">
					<h2 id="writing-title">Recent writing</h2>
					<a href="/blog">All writing</a>
				</header>
				<div class="writing-list">
					{posts.map((post) => (
						<article>
							<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
						</article>
					))}
				</div>
				</div>
			</section>

			<section class="workspace-pane environment-pane" tabindex="0" aria-labelledby="environment-title">
				<div class="workspace-pane-scroll">
				<header class="pane-heading">
					<h2 id="environment-title">Desktop tools</h2>
					<a href="/software">All software</a>
				</header>
				<ul class="tool-list">
					{desktopTools.map((item) => (
						<li>
							<img src={item.data.icon} alt="" width="30" height="30" />
							<div>
								<h3><a href={item.data.url}>{item.data.title}</a></h3>
								<p>{item.data.description}</p>
							</div>
						</li>
					))}
				</ul>
				</div>
			</section>
		</main>
		</div>
	</body>
</html>

<style>
	.home-workspace {
		display: grid;
		grid-template-columns: minmax(0, 1.62fr) minmax(280px, 1fr);
		grid-template-rows: minmax(0, 1fr) minmax(0, 0.72fr);
		gap: var(--inner-gap);
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		padding: 0;
		overflow: hidden;
	}

	.lead-pane {
		grid-row: 1 / -1;
		padding: clamp(1.3rem, 2.8vw, 2.65rem);
	}

	.home-intro {
		padding-bottom: clamp(1rem, 2vw, 1.8rem);
		border-bottom: 1px solid var(--rule);
	}

	.home-intro h1 {
		margin-bottom: 0.35rem;
		font-size: clamp(1.8rem, 3vw, 2.35rem);
	}

	.home-intro p {
		margin: 0;
		color: var(--text-muted);
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
	}

	.lead-project {
		width: min(100%, 76ch);
		align-self: center;
		padding: clamp(1.4rem, 3vw, 3rem) 0;
	}

	.project-heading {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.15rem;
	}

	.project-heading img {
		width: 58px;
		height: 58px;
		flex: 0 0 58px;
		object-fit: contain;
	}

	.project-heading h2 {
		margin: 0;
		color: var(--focus-companion);
		font-size: clamp(1.55rem, 2.6vw, 2.15rem);
	}

	.project-description {
		margin-bottom: 1rem;
		color: var(--text-bright);
		font-size: clamp(1.08rem, 1.7vw, 1.25rem);
		line-height: 1.55;
	}

	.project-copy {
		color: var(--text-muted);
	}

	.project-copy :global(p) {
		margin-bottom: 1.35rem;
	}

	.project-actions {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.project-actions a {
		font-size: 0.9rem;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--default);
		border-radius: 6px;
		background: var(--module-bg);
		color: var(--text-bright);
		text-decoration: none;
	}

	.primary-link:hover,
	.primary-link:focus-visible {
		border-color: var(--focus-companion);
		color: var(--focus-companion);
	}

	.writing-pane,
	.environment-pane {
		padding: clamp(1rem, 2vw, 1.6rem);
	}

	.pane-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}

	.pane-heading h2 {
		margin: 0;
		font-size: clamp(1.22rem, 2vw, 1.55rem);
	}

	.pane-heading > a {
		flex: 0 0 auto;
		font-size: 0.88rem;
	}

	.writing-list article {
		padding: 1rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.writing-list article:last-child {
		border-bottom: 0;
	}

	time {
		display: block;
		margin-bottom: 0.4rem;
		color: var(--green);
		font-size: 0.85rem;
	}

	.writing-list h3 {
		margin-bottom: 0.5rem;
		font-size: clamp(0.98rem, 1.5vw, 1.14rem);
		line-height: 1.35;
	}

	.writing-list h3 a,
	.tool-list h3 a {
		color: var(--text-bright);
		text-decoration: none;
	}

	.writing-list h3 a:hover,
	.writing-list h3 a:focus-visible,
	.tool-list h3 a:hover,
	.tool-list h3 a:focus-visible {
		color: var(--focus-companion);
	}

	.writing-list p,
	.tool-list p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.tool-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tool-list li {
		display: grid;
		grid-template-columns: 30px minmax(0, 1fr);
		gap: 0.8rem;
		padding: 0.82rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.tool-list li:last-child {
		border-bottom: 0;
	}

	.tool-list img {
		width: 30px;
		height: 30px;
		border-radius: 5px;
	}

	.tool-list h3 {
		margin: 0 0 0.25rem;
		font-size: 0.98rem;
	}

	@media (max-width: 700px) {
		.home-workspace {
			display: block;
			overflow-x: hidden;
			overflow-y: auto;
			border: 3px solid var(--boundary);
			border-radius: var(--window-radius);
			background: var(--pane-fill);
			backdrop-filter: blur(5px);
			-webkit-backdrop-filter: blur(5px);
		}

		.lead-pane,
		.writing-pane,
		.environment-pane {
			display: block;
			overflow: visible;
			border: 0;
			border-bottom: 1px solid var(--rule);
			border-radius: 0;
			background: transparent;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}

		.environment-pane {
			border-bottom: 0;
		}

		.lead-pane::after,
		.writing-pane::after,
		.environment-pane::after {
			display: none;
		}

		.home-intro h1 {
			font-size: 1.65rem;
		}

		.lead-project {
			padding-bottom: 1rem;
		}
	}
</style>
