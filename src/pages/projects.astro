---
import { getCollection } from 'astro:content';
import ProgramPage from '../layouts/ProgramPage.astro';

const projects = await getCollection('projects');
---

<ProgramPage programs={projects}>
			<h1>Personal Projects</h1>
			<p>
				This is a list of projects I have made in my free time to explore my passion as a software developer and solve problems I encounter on a regular basis.
				I'm almost always working on a project in the background.
				All of my personal projects are and will always be free software liscened under the GPL or one of its variants (most often GPLv3).
			</p>
</ProgramPage>
