---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Bar from '../components/Bar.astro';
import TerminalCard from '../components/TerminalCard.astro';
import TerminalLayout from '../components/TerminalLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = await getCollection('projects');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label="Projects">
			<main>
				<TerminalLayout title="Projects" description="Personal projects built to solve problems I encounter.">
					<div class="catalog-grid">
						{projects.map(async (project) => {
							const { Content } = await render(project);
							return (
								<TerminalCard
									title={project.data.title}
									description={project.data.description ?? ''}
									icon={project.data.icon}
									url={project.data.url}
								>
									<Content />
								</TerminalCard>
							);
						})}
					</div>
				</TerminalLayout>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
	}

	@media (max-width: 720px) {
		.catalog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
