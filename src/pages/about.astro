---
import Bar from '../components/Bar.astro';
import BaseHead from '../components/BaseHead.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label="About Cyan">
			<main>
				<div class="about-layout">
					<a class="photo-link" href="https://github.com/Cyanistic" aria-label="Cyanistic on GitHub">
						<img src="/me.png" alt="Cyanistic" width="116" height="116" />
					</a>
					<article>
						<h1>Cyanistic</h1>

						<section>
							<h2>Background</h2>
							<p>Software engineer and tech enthusiast living in the US. Graduated Summa Cum Laude from Florida International University with a B.S. in Computer Science.</p>
						</section>

						<section>
							<h2>Work</h2>
							<p>Passionate about building platform infrastructure: tools that let other engineers move faster and make fewer mistakes. When it comes to programming, Rust is my language of choice. The memory safety features and concise syntax make it a breeze to write clean, efficient code.</p>
						</section>

						<section>
							<h2>Skills</h2>
							<p>Primary: Rust. Also proficient in JavaScript, TypeScript, and Python. Always looking to expand my skill set and learn new technologies.</p>
						</section>

						<section>
							<h2>Interests</h2>
							<p>Gaming on my Linux machine (Beat Saber, strategy games). Hyprland power user. Big fan of free and open-source software. I believe software should be free and open to everyone.</p>
						</section>
					</article>
				</div>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.about-layout {
		display: grid;
		grid-template-columns: 116px minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		max-width: 78ch;
		margin: 0 auto;
	}

	.photo-link,
	.photo-link img {
		display: block;
	}

	.photo-link img {
		width: 116px;
		height: 116px;
		border: 2px solid var(--boundary);
		border-radius: 10px;
	}

	h1 {
		margin-bottom: 1.5rem;
	}

	section {
		padding: 1.15rem 0;
		border-top: 1px solid var(--rule);
	}

	section h2 {
		margin-bottom: 0.5rem;
		font-size: 1.05rem;
	}

	section p {
		margin: 0;
		color: var(--text-muted);
	}

	@media (max-width: 620px) {
		.about-layout {
			grid-template-columns: 1fr;
		}

		.photo-link {
			width: max-content;
		}
	}
</style>
