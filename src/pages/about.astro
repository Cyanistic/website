---
import BaseHead from '../components/BaseHead.astro';
import Bar from '../components/Bar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Fragment } from 'astro/jsx-runtime';
import TerminalWindow from '../components/TerminalWindow.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar title={SITE_TITLE} />
		<TerminalWindow>
			<main transition:animate="fade">
				<h1>
					About Me
				</h1>
				<h2>
					Me when the man and the mcdonalds
				</h2>
				<p>
					Hello guys welcome to Francis vlog channel, today we have the big homie as a guest. What a gay little man we have here with the little pumper!! 
				</p>
			</main>
		</TerminalWindow>
	</body>
</html>

