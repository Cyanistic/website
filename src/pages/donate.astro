---
import Bar from '../components/Bar.astro';
import BaseHead from '../components/BaseHead.astro';
import TerminalLayout from '../components/TerminalLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Donate | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Bar />
		<TerminalWindow label="Donate">
			<main>
				<TerminalLayout title="Donate" description="If any of my work has helped you, consider donating to help a brother out.">
					<section class="crypto-section">
						<h2>Crypto</h2>
						<p>All crypto I hold is self custody.</p>
						<div class="crypto-grid">
							<article>
								<h3>BTC</h3>
								<code>—</code>
								<p>Bitcoin, peer-to-peer electronic cash</p>
							</article>
							<article>
								<h3>XMR</h3>
								<code>85Av2R33NXP2G6vgKQKSqXX2pttxzjTnrK82g1ops4HZ68pidaPZPCTTJNiVDknFngYasREXq5wd3Tvog7PFeuoGUhXFDQP</code>
								<p>Monero, private, secure, untraceable</p>
							</article>
						</div>
					</section>
				</TerminalLayout>
			</main>
		</TerminalWindow>
	</body>
</html>

<style>
	.crypto-section {
		max-width: 78ch;
	}

	.crypto-section > h2 {
		font-size: 1.2rem;
	}

	.crypto-section > p {
		color: var(--text-muted);
	}

	.crypto-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.crypto-grid article {
		min-width: 0;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}

	.crypto-grid h3 {
		color: var(--focus-companion);
		font-size: 1rem;
	}

	.crypto-grid code {
		display: block;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.crypto-grid p {
		margin-top: 0.6rem;
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	@media (max-width: 720px) {
		.crypto-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
